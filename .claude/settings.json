{
  "permissions": {
    "allow": [
      "Bash(obsidian.com quartz-syncer:*)",
      "Bash(python .claude/scratch/jcheck.py:*)",
      "Bash(python .claude/scratch/linkcheck.py:*)",
      "Bash(bash .claude/scratch/exdraw/go.sh:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "obsidian.com quartz-syncer:mark path=\"Public/**\" state=publish && obsidian.com quartz-syncer:publish"
          }
        ]
      }
    ]
  }
}
